{
  "name": "@pravosleva/reactive-engine",
  "version": "0.4.1-beta",
  "engines": {
    "node": ">=22.20.0"
  },
  "description": "JS Reactive Engine",
  "author": "Den Pol <selection4test@gmail.com> (https://pravosleva.pro)",
  "homepage": "https://github.com/garage-13/reactive-engine",
  "repository": "github:garage-13/reactive-engine",
  "license": "MIT",
  "keywords": [
    "reactive",
    "engine",
    "react",
    "fast",
    "state",
    "manager"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.iife.js",
  "jsdelivr": "./dist/index.iife.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "start": "vite --host --open",
    "build": "vite build",
    "test": "NODE_OPTIONS='--expose-gc' vitest run",
    "test:ui": "NODE_OPTIONS='--expose-gc' vitest --ui",
    "test:watch": "vitest",
    "preversion": "npm run test",
    "prepublishOnly": "npm run test && npm run build",
    "postversion": "git push && git push --tags"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.2.0",
    "react-dom": "^18.0.0 || ^19.2.0"
  },
  "devDependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@microsoft/api-extractor": "^7.58.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/google.maps": "^3.65.2",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/ui": "^4.1.10",
    "@yandex/ymaps3-clusterer": "^0.0.12",
    "clsx": "^2.1.1",
    "jsdom": "^29.1.1",
    "kaplay": "^3001.0.19",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "mapbox-gl": "^3.26.0",
    "msw": "^2.15.0",
    "phaser": "^4.2.1",
    "pixi.js": "^8.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sass-embedded": "^1.100.0",
    "three": "^0.185.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}