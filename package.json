{
  "name": "@pravosleva/reactive-engine",
  "version": "0.3.2-beta",
  "engines": {
    "node": "22.20.0"
  },
  "description": "JS Reactive Engine",
  "author": "Den Pol <selection4test@gmail.com> (https://pravosleva.pro)",
  "homepage": "https://github.com/garage-13/reactive-engine",
  "repository": "github:garage-13/reactive-engine",
  "license": "MIT",
  "keywords": [
    "reactive",
    "engine",
    "react",
    "fast",
    "state",
    "manager"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.iife.js",
  "jsdelivr": "./dist/index.iife.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "start": "vite --host --open",
    "build": "vite build",
    "test": "NODE_OPTIONS='--expose-gc' vitest run",
    "test:ui": "NODE_OPTIONS='--expose-gc' vitest --ui",
    "test:watch": "vitest",
    "preversion": "npm run test",
    "prepublishOnly": "npm run test && npm run build",
    "postversion": "git push && git push --tags"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/ui": "^4.1.10",
    "jsdom": "^29.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}