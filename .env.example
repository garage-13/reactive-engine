VITE_BASE_API_URL=http://local.devtool-1.ru/express-helper/mg/mocks
VITE_YANDEX_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VITE_MAPBOX_API_KEY=

# --- НАСТРОЙКИ КОНВЕЙЕРА РЕФАКТОРИНГА AIDER для .env.development
# Список файлов для ИИ через пробел (Aider автоматически построит их граф вызовов)
AIDER_FILES="src/utils/index.ts, src/core/core.ts"
# Имя итогового патч-файла на выходе
AIDER_OUTPUT_PATCH="qwen_refactoring_changes.patch"
# Текстовое задание для локальной модели Qwen
AIDER_TASK="Оптимизируй метод .destroy() в файле src/core/core.ts для предотвращения утечек памяти в подписках сигналов. Также добавь в самый конец файла src/utils/index.ts новую строку комментария: // Тестовый комментарий от ИИ для проверки Word Wrap. Выведи только патч, без лишних слов."
# ---
