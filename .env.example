VITE_BASE_API_URL=http://local.devtool-1.ru/express-helper/mg/mocks
VITE_YANDEX_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VITE_MAPBOX_API_KEY=

# ==============================================================================
# КОНФИГУРАЦИЯ ЛОКАЛЬНОГО LLM-ПОРТАЛА (ПРОМЫШЛЕННЫЙ СТАНДАРТ)
# ==============================================================================

# Базовый URL локального или удаленного ИИ-сервера
AIDER_OLLAMA_API_BASE="http://127.0.0.1:11434"

# Целевая модель для проведения комплексного рефакторинга
AIDER_MODEL="ollama/qwen2.5-coder-long"

# Формат генерации изменений (diff, whole, edit-block, architect)
AIDER_EDIT_FORMAT="diff"

# Запрет на автоматическое создание коммитов ИИ в истории Git (true/false)
AIDER_DISABLE_AUTO_COMMITS=true

# ==============================================================================
# НАСТРОЙКИ КОНВЕЙЕРА И ПАРАМЕТРЫ ЗАДАЧИ
# ==============================================================================

# Имя итогового патч-файла на выходе
AIDER_OUTPUT_PATCH="qwen_refactoring_changes.patch"

# Список целевых файлов для анализа графа вызовов (через запятую)
AIDER_FILES="src/utils/index.ts,src/core/core.ts"

# Архитектурное задание для ИИ-агента
AIDER_TASK="Оптимизируй метод .destroy() в файле src/core/core.ts для предотвращения утечек памяти в подписках сигналов. Также добавь в самый конец файла src/utils/index.ts новую строку комментария: // Тестовый комментарий от ИИ для проверки Word Wrap. Выведи только патч, без лишних слов."
